# Copy to .env (git-ignored). docker compose reads it for the hindsight service.

# --- Hindsight: the LLM it runs to extract facts when retaining a memory ---------
# Default: local Ollama, free and keyless. Pull the model first: ollama pull qwen3:14b
HINDSIGHT_API_LLM_PROVIDER=ollama
HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:11434/v1
HINDSIGHT_API_LLM_MODEL=qwen3:14b
HINDSIGHT_API_LLM_API_KEY=

# Faster: Groq's free tier (API key, no card)
# HINDSIGHT_API_LLM_PROVIDER=groq
# HINDSIGHT_API_LLM_BASE_URL=https://api.groq.com/openai/v1
# HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b   (or qwen/qwen3-32b)
# HINDSIGHT_API_LLM_API_KEY=gsk_...

# --- Vesyn API: set in the API's environment; these are the defaults ------------
# VESYN_HINDSIGHT_URL=http://127.0.0.1:8888   # "none" disables memory
# VESYN_HINDSIGHT_BANK=vesyn-research
# HINDSIGHT_API_KEY=                          # only for Hindsight Cloud
